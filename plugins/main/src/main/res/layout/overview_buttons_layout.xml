<?xml version="1.0" encoding="utf-8"?>
<!-- Alterado pelo Tarciso -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buttons_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="5"
    android:background="@color/defaultBackground"
    android:elevation="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Main Button -->
    <LinearLayout
        android:id="@+id/home_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">
        
        <ImageView
            android:id="@+id/home_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_graph_line"/>
        
        <TextView
            android:id="@+id/home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main"
            android:textSize="10sp"
            android:textColor="@color/defaultTextColor"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Tools Button (formerly History) -->
    <!-- Alterado pelo Tarciso - Changed from History to Tools -->
    <LinearLayout
        android:id="@+id/tools_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">
        
        <ImageView
            android:id="@+id/tools_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"/>
        
        <TextView
            android:id="@+id/tools_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tools"
            android:textSize="10sp"
            android:textColor="@color/defaultTextColor"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Bolus Button -->
    <LinearLayout
        android:id="@+id/bolus_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">
        
        <ImageView
            android:id="@+id/bolus_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bolus"/>
        
        <TextView
            android:id="@+id/bolus_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bolus"
            android:textSize="10sp"
            android:textColor="@color/defaultTextColor"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Adjustments/Overrides Button -->
    <LinearLayout
        android:id="@+id/override_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">
        
        <ImageView
            android:id="@+id/override_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sliders"/>
        
        <TextView
            android:id="@+id/override_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Config Builder"
            android:textSize="10sp"
            android:textColor="@color/defaultTextColor"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Settings Button -->
    <LinearLayout
        android:id="@+id/settings_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">
        
        <ImageView
            android:id="@+id/settings_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"/>
        
        <TextView
            android:id="@+id/settings_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferences"
            android:textSize="10sp"
            android:textColor="@color/defaultTextColor"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Hidden legacy buttons for compatibility -->
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/home_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/history_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/bolus_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/override_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/settings_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/accept_temp_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/treatment_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/insulin_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/carbs_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/wizard_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/calibration_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/cgm_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <app.aaps.core.ui.elements.SingleClickButton android:id="@+id/quick_wizard_button" style="@style/ButtonSmallFontStyle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</LinearLayout>
