<?xml version="1.0" encoding="utf-8"?>
<!-- Alterado pelo Tarciso - Glass UI dock com sombra difusa (imita Modifier.shadow dos cards) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada de sombra difusa (preto translúcido), visível abaixo/bordas da barra -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#330F172A" />
        </shape>
    </item>
    <!-- Camada de vidro por cima, deslocada para cima para revelar a sombra na base -->
    <item
        android:top="0dp"
        android:bottom="6dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#F2FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#80CBD5E1" />
        </shape>
    </item>
</layer-list>
