<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    >

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        app:columnCount="4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rowCount="3">

        <!-- CARD: BG / Arrow/ Delta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bg"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textAlignment="center"
                    android:text="00"
                    android:textSize="32sp"
                    android:textStyle="bold"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="@+id/bg">

                    <ImageView
                        android:id="@+id/arrow"
                        android:layout_width="35dp"
                        android:layout_height="19dp"
                        android:contentDescription="@string/trend_arrow" />


                    <TableRow
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:focusable="true">

                        <TextView
                            android:layout_width="17dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:textAlignment="textEnd"
                            android:text="Δ: "/>

                        <TextView
                            android:id="@+id/delta"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textAlignment="center"
                            tools:text="n/a" />
                    </TableRow>
                </LinearLayout>













            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Loop / Time Ago -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/aps_mode"
                    android:layout_width="53dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_loop_closed"
                    android:contentDescription="@string/aps_mode_title" />

                <TextView
                    android:id="@+id/time_ago"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textAlignment="center"
                    android:text="n/a"
                    android:textSize="15sp"/>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- CARD: IOB -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_bolus"
                    android:contentDescription="@string/iob" />

                <TextView
                    android:id="@+id/iob"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:textAlignment="center"
                    android:text="n/a"
                    android:textSize="15sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: TARGET -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:id="@+id/temp_target_icon"
                android:contentDescription="@string/temporary_target"  />



            <TextView
                android:id="@+id/temp_target"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:textAlignment="center"
                android:text="n/a"
                android:textSize="15sp"/>

            </LinearLayout>




        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: Bateria -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="100%"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Bateria"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: Tradução -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Tradutor"
                android:textSize="20sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: Passos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="85.000"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Passos"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: CPU -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="CPU 34%"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
